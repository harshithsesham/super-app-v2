# Meta Model API (Standard tier). Create a key at https://dev.meta.ai -> API keys.
# Either variable name works; MODEL_API_KEY is Meta's own.
META_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MODEL=muse-spark-1.3

# Per-user agent home (standing files, memory tree, workspace)
SUPERAPP_HOME=~/.superapp/home

# Shared services (docker compose up)
DATABASE_URL=postgresql://superapp:superapp@localhost:5432/superapp
QDRANT_URL=http://localhost:6333
